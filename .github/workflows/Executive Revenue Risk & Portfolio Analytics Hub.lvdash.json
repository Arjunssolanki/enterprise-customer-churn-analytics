{
  "datasets": [
    {
      "name": "bf48cf9b",
      "displayName": "final_predictions_output",
      "config": {
        "version": "1.1",
        "source": "workspace.customer_churn_analytics.final_predictions_output",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "06ae7c67",
      "displayName": "Revenue_Simulation_Engine",
      "queryLines": [
        "SELECT \r\n",
        "    COUNT(DISTINCT customer_id) AS total_portfolio_accounts,\r\n",
        "    SUM(predicted_lifetime_value) AS total_portfolio_clv,\r\n",
        "    AVG(churn_risk_score) AS average_portfolio_churn_risk,\r\n",
        "    SUM(CASE WHEN risk_tier = 'High Risk' THEN current_monthly_rev ELSE 0.00 END) AS monthly_revenue_at_risk,\r\n",
        "    SUM(CASE WHEN risk_tier = 'High Risk' THEN current_monthly_rev ELSE 0.00 END) * :RetentionImprovement AS simulated_revenue_recaptured,\r\n",
        "    SUM(predicted_lifetime_value) + (SUM(CASE WHEN risk_tier = 'High Risk' THEN current_monthly_rev ELSE 0.00 END) * :RetentionImprovement * 12) AS final_simulated_portfolio_value\r\n",
        "FROM customer_churn_analytics.final_predictions_output;\r\n"
      ],
      "parameters": [
        {
          "displayName": "RetentionImprovement",
          "keyword": "RetentionImprovement",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "0.10"
                }
              ]
            }
          }
        }
      ]
    }
  ],
